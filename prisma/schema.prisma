datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}


model Item {
  name          String    @unique
  description   String?
  rarity        String?
  tags          String?   @default("[]")
  links         String?   @default("[]")

  @@map("item")
}


model Character {
  name              String    @unique
  short_description String?
  description       String?   
  tags              String?   @default("[]")
  relations         String?   @default("[]")
  links             String?   @default("[]")

  @@map("character")
}


model World {
  name          String    @unique
  description   String?
  tags          String?   @default("[]")
  links         String?   @default("[]")

  @@map("world")
}